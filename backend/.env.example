PORT=5000
NODE_ENV=development

# MongoDB — single URI for the active environment
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/wevibe
# Production (Atlas) — set in your host's environment:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wevibe?retryWrites=true&w=majority

# Firebase Admin (path to service account JSON, not committed)
FIREBASE_ADMIN_KEY_PATH=./firebase-adminsdk.json

# YouTube / Spotify
YT_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# CORS — comma-separated allowed origins
FRONTEND_URL=http://localhost:3000

# Optional
# JWT_SECRET=change-me-in-production
# NO_PERSIST=false
